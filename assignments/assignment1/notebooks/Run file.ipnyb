   "source": [
    "from pathlib import Path\n",
    "import csv\n",
    "import nbformat\n",
    "from nbclient import NotebookClient\n",
    "import numpy as np\n",
    "\n",
    "# Change this to your notebook's exact filename\n",
    "notebook_path = Path(\"assignment1_template (1) (4).ipynb\").resolve()\n",
    "output_folder = notebook_path.parent / \"repeated_run_results\"\n",
    "output_folder.mkdir(exist_ok=True)\n",
    "\n",
    "records = []\n",
    "\n",
    "base_seed = 1000\n",
    "\n",
    "for run in range(1, 11):\n",
    "    # Read a clean copy for each run\n",
    "    notebook = nbformat.read(notebook_path, as_version=4)\n",
    "    for cell in notebook.cells:\n",
    "        if cell.cell_type == \"code\":\n",
    "            cell.outputs = []\n",
    "            cell.execution_count = None\n",
    "\n",
    "    # Identify the final code cell containing actual code\n",
    "    last_code_index = max(\n",
    "        i for i, cell in enumerate(notebook.cells)\n",
    "        if cell.cell_type == \"code\" and cell.source.strip()\n",
    "    )\n",
    "\n",
    "    print(f\"Starting run {run}/10...\", flush=True)\n",
    "\n",
    "    # Each client execution starts and shuts down a fresh kernel\n",
    "    client = NotebookClient(\n",
    "        notebook,\n",
    "        timeout=1200,  # Maximum seconds allowed per cell\n",
    "        resources={\"metadata\": {\"path\": str(notebook_path.parent)}},\n",
    "    )\n",
    "\n",
    "    try:\n",
    "        client.execute()\n",
    "\n",
    "        # Collect print statements from the last code cell\n",
    "        printed_output = \"\".join(\n",
    "            output.get(\"text\", \"\")\n",
    "            for output in notebook.cells[last_code_index].outputs\n",
    "            if output.output_type == \"stream\"\n",
    "        )\n",
    "\n",
    "        status = \"completed\"\n",
    "\n",
    "    except Exception as exc:\n",
    "        printed_output = f\"{type(exc).__name__}: {exc}\"\n",
    "        status = \"failed\"\n",
    "\n",
    "    # Save each executed notebook, including outputs for inspection\n",
    "    nbformat.write(\n",
    "        notebook,\n",
    "        output_folder / f\"run_{run:02d}.ipynb\"\n",
    "    )\n",
    "\n",
    "    records.append({\n",
    "        \"run\": run,\n",
    "        \"status\": status,\n",
    "        \"output\": printed_output,\n",
    "    })\n",
    "\n",
    "    # Update the combined text log after every run\n",
    "    combined_output = \"\\n\\n\".join(\n",
    "        f\"RUN {record['run']} — {record['status']}\\n\"\n",
    "        f\"{record['output']}\"\n",
    "        for record in records\n",
    "    )\n",
    "\n",
    "    (output_folder / \"all_runs.txt\").write_text(\n",
    "        combined_output,\n",
    "        encoding=\"utf-8\"\n",
    "    )\n",
    "\n",
    "    # Save a CSV with one row per run\n",
    "    with (output_folder / \"all_runs.csv\").open(\n",
    "        \"w\", newline=\"\", encoding=\"utf-8\"\n",
    "    ) as file:\n",
    "        writer = csv.DictWriter(\n",
    "            file, fieldnames=[\"run\", \"status\", \"output\"]\n",
    "        )\n",
    "        writer.writeheader()\n",
    "        writer.writerows(records)\n",
    "\n",
    "    print(printed_output, flush=True)\n",
    "\n",
    "    \n",
    "print(f\"\\nResults saved to: {output_folder}\")"
   ]
  },
